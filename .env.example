# Listen port (Render sets PORT itself)
PORT=8787

# Meta Model API — https://dev.meta.ai/docs/authentication
MODEL_API_KEY=
# MODEL_API_BASE_URL=https://api.meta.ai/v1
# MODEL_API_TIMEOUT_MS=90000
# Hard request limits (fail fast, nothing sent when exceeded)
# MODEL_API_MAX_REQUESTS_PER_HOUR=120
# MODEL_API_MAX_CONCURRENT=4  # at least 2: a sam+spark read holds 2 in-flight slots
# Percent of the hourly cap kept for critical beds; routine reads stop at the rest (84 of 120 at 30). 0–90.
# CRITICAL_RESERVE_PCT=30
# BUDGET_PRESSURE_PCT=50  # from this share of the cap in use, stable-bed and bedless sam+spark reads make 1 request

# Model IDs (https://dev.meta.ai/docs/models)
# SPARK_MODEL=muse-spark-1.3
# SAM_MODEL=sam-3.1
# ASR_MODEL=muse-voice-transcribe-1.0

# Reasoning effort: minimal|low|medium|high|xhigh|max
# SPARK_READ_EFFORT=medium
# SPARK_NOTE_EFFORT=low

# Run SAM before Spark on photo reads (accuracy aid; adds latency + $0.0025/photo)
# READ_USE_SAM=true
# MEAL_USE_SAM=true  # tray reads: SAM dish + food + Spark (3 requests); false: Spark only (1)

# Server security
# NODE_ENV=development
# Listen address; keep loopback unless a reverse proxy/TLS sits in front (Render: 0.0.0.0)
# HOST=127.0.0.1
# Proxies in front of the server whose X-Forwarded-For / X-Forwarded-Proto are trusted (0–3). 1 on Render.
# TRUST_PROXY_HOPS=0
# The web build served outside /api (default: apps/web/dist; production refuses to start without it)
# WEB_DIST=
# How long requests in flight may finish after SIGTERM before their connections are closed (ms)
# SHUTDOWN_GRACE_MS=25000
# Per-client /api/ai/* requests per rolling minute (and, separately, password checks)
# AI_RATE_LIMIT_PER_MINUTE=20
# Demo sign-in (username and password: the demo staff member's lowercase first name). Always on outside production;
# in production only with MENISCUS_DEMO_LOGIN=1. Production also marks the session cookie Secure: serve over HTTPS or localhost.
# MENISCUS_DEMO_LOGIN=

# Chart database (Postgres), required: the server and its scripts refuse to start without DATABASE_URL. Secrets: never
# commit, never log. Migrations (apps/server/drizzle) run at start on the session URL, or with `pnpm db:migrate`.
# Local: the Supabase CLI stack (`pnpm dev:stack`) on 54322, no TLS on a loopback host. Create the database once:
#   psql postgresql://postgres:postgres@127.0.0.1:54322/postgres -c 'create database meniscus_dev'
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/meniscus_dev
# Migrations (and later a queue worker's LISTEN): a session connection, never Supavisor's 6543. Default DATABASE_URL.
# DATABASE_SESSION_URL=
# Supabase hosted, through Supavisor (Render has no outbound IPv6): transaction mode (6543) for requests,
# session mode (5432) for migrations. A remote host needs sslmode=verify-full and DATABASE_CA_FILE.
# DATABASE_URL=postgresql://meniscus_app.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=verify-full
# DATABASE_SESSION_URL=postgresql://meniscus_app.<project_ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full
# Supabase's CA (Database Settings → SSL), trusted together with Node's root CAs; unset on loopback. On Render:
# /etc/secrets/supabase-ca.crt
# DATABASE_CA_FILE=
# Connections per server process (1–20, default 5)
# DATABASE_POOL_MAX=5

# Media store (photos, recordings): an S3 bucket in every environment; production requires MEDIA_STORE=s3.
# Unset outside production: memory (media is lost on restart while its rows remain; reads then answer 503).
# Local: run `pnpm dev:stack` and copy S3 Storage URL, S3 Access Key, S3 Secret Key and S3 Region from its output.
# MEDIA_STORE=s3
# S3_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
# S3_REGION=local
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Supabase hosted (Storage → S3 configuration; https required in production, except a loopback host):
# S3_ENDPOINT=https://<project_ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=<project region, e.g. eu-central-1 (Frankfurt, next to Render)>
# S3_BUCKET=meniscus-media
# S3_FORCE_PATH_STYLE=true

# Tests only: a Postgres the tests may create databases on (e.g. the local stack). Unset: those tests skip.
# PG_TEST_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Dev scripts. demo:capture (a plain HTTP client of a deployed app; no database or bucket access): the demo
# attendant's password, when it is not the username.
# DEMO_CAPTURE_PASSWORD=
