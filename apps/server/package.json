{
  "name": "@meniscus/server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "tsx --env-file-if-exists=../../.env src/index.ts",
    "start:prod": "node src/index.ts",
    "typecheck": "tsc -p .",
    "test": "TZ=Asia/Kolkata tsx --no-memory-protection-keys --test --test-global-setup=./src/db/testing.ts 'src/**/*.test.ts'",
    "eval": "tsx --env-file-if-exists=../../.env scripts/eval.ts",
    "synth": "tsx --env-file-if-exists=../../.env scripts/synth-images.ts",
    "demo": "tsx --env-file-if-exists=../../.env scripts/demo-history.ts",
    "demo:capture": "tsx scripts/demo-capture.ts",
    "fake": "tsx scripts/fake-server.ts",
    "preflight": "tsx --env-file-if-exists=../../.env scripts/preflight.ts",
    "media:sweep": "tsx --env-file-if-exists=../../.env scripts/media-sweep.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env scripts/db-migrate.ts",
    "db:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@meniscus/meta": "workspace:*",
    "@meniscus/shared": "workspace:*",
    "@hono/node-server": "2.1.5",
    "@hono/zod-validator": "0.9.1",
    "aws4fetch": "1.0.20",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.14",
    "postgres": "3.4.9",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@meniscus/config": "workspace:*",
    "@electric-sql/pglite": "0.5.15",
    "@electric-sql/pglite-socket": "0.2.18",
    "@types/node": "^24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15"
  }
}
